# Public URL of the deployed invitation (used for share links & Open Graph image URLs)
VITE_SITE_URL=https://your-wedding.vercel.app

# Where RSVPs are POSTed as JSON. Leave empty for DEMO mode (nothing is saved).
# Works with Google Apps Script web apps, Formspree, Getform, or your own API.
# This URL is public by nature; never put secret API keys in VITE_* variables.
VITE_RSVP_ENDPOINT=
